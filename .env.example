# Utilisé uniquement en dev local (npm run dev), lu par vite.config.js /
# src/api/client.js via import.meta.env. En production, l'URL de l'API vient
# de la variable d'environnement API_URL du conteneur (voir
# enervision-devops/compose/dashboard.yml + docker/entrypoint.sh), pas de
# ce fichier.

VITE_API_URL=http://localhost:3000
